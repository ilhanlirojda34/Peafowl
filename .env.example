# Local database container (docker compose reads these). Keep DATABASE_URL in sync.
POSTGRES_USER=peafowl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=peafowl
POSTGRES_PORT=5432

DATABASE_URL=postgres://peafowl:change-me@localhost:5432/peafowl
TEST_DATABASE_URL=postgres://peafowl:change-me@localhost:5432/peafowl_test

# LLM. Required. Create a key in Google AI Studio.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_MS=300000
LLM_IDLE_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# API
API_HOST=127.0.0.1
API_PORT=3001
FREE_PLAN_PROJECT_LIMIT=2
# Generation allowance per workspace. Each rule limits the listed kinds together; windowDays is a
# rolling window, null means lifetime. Every kind needs a rule. Edits are not offered yet (0).
FREE_PLAN_GENERATION_QUOTAS=[{"kinds":["create"],"limit":2,"windowDays":null},{"kinds":["edit"],"limit":0,"windowDays":null}]
# Development-only sign-in with the x-dev-user-email header. Refused when NODE_ENV=production.
DEV_AUTH=true

# Worker. Keep low on free LLM tiers.
WORKER_CONCURRENCY=1

# Shared
LOG_LEVEL=info

# Eval runner. Keep low on free LLM tiers.
EVAL_CONCURRENCY=2
