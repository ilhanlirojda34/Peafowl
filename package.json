{
  "name": "peafowl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env apps/worker/src/main.ts",
    "generate": "tsx --env-file-if-exists=.env packages/generator/src/cli.ts",
    "eval": "tsx --env-file-if-exists=.env packages/generator/evals/run.ts",
    "db:generate": "npm run db:generate -w @peafowl/db --",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "tsx --test \"packages/*/src/**/*.test.ts\" \"packages/*/evals/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "test:integration": "tsx --env-file-if-exists=.env --test --test-concurrency=1 \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
